{
	"name": "create-hidra",
	"version": "2.0.0",
	"type": "module",
	"bin": {
		"create-hidra": "./dist/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"template"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"format": "prettier --write src"
	},
	"dependencies": {
		"kolorist": "^1.8.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"tsdown": "^0.21.4",
		"typescript": "^5.9.3"
	}
}
