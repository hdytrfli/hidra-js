{
	"name": "@hidrajs/vite-plugin",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs"
		},
		"./vite-env": {
			"types": "./src/types/vite-env.d.ts"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src/types"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests",
		"format": "prettier --write src tests"
	},
	"peerDependencies": {
		"vite": "^8.0.0",
		"handlebars": "^4.7.8"
	},
	"dependencies": {
		"@hidrajs/loader": "workspace:*",
		"fast-glob": "^3.3.3",
		"jiti": "^2.6.1",
		"lodash.merge": "^4.6.2",
		"pathe": "^2.0.3"
	},
	"devDependencies": {
		"@types/lodash.merge": "^4.6.9",
		"@types/node": "^22.15.0",
		"handlebars": "^4.7.8",
		"tsdown": "^0.21.4",
		"typescript": "^5.9.3",
		"vite": "^8.0.1",
		"vitest": "^4.1.0"
	}
}
